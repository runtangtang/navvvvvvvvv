# =============================================================================
#  nav_interfaces/action/NavigateTo.action
#  导航组 → 组2 · 任务接口
#
#  ★ 一份文件，双方各自编译（这就是 ROS2 Action 的用法，不是"谁给谁"）
#  ★ 字段与单位【一旦发出去就不好改了】—— 现在定死
#
#  ★★ 单位约定（踩过坑，一定要看清）：
#      所有位置   [米]
#      所有角度   【弧度】（不是度！）
#      所有时间   [秒]
#      所有速度   [米/秒]、[弧度/秒]
# =============================================================================

# ============================== goal（组2 → 我们） ==========================
# 一次导航任务 = 从起点走到终点
#
# ★★ 起点 s_* 是【开机对齐】的输入（2026-09-27 起真的生效了）：
#      【第一个 goal】 s_* ⇒ 把它当作狗此刻真实所在，用它建立坐标系变换 T
#                          （T 建立后全程不变）
#      【后续每个 goal】s_* ⇒ 不重建 T，只做校验：
#                          和"我们以为狗在哪"比
#                            ≤ 0.20m ⇒ 一致，沿用现有 T
#                            > 0.20m ⇒ 报警 + 重建 T
# ★★ 多段任务：s_* 必须【链式】—— 第 N 段的 s_* = 第 N-1 段的 g_*
#      （每段都填同一个 s_* 会被判成"不一致" ⇒ 触发重对齐 + 报警，那是误报）
#
# ★ 狗必须【真的停在】那个起点上；停偏了多少，全程就错多少（我们无从察觉）

float64 s_x                 # 起点 x [m]，场景图坐标系
float64 s_y                 # 起点 y [m]
float64 s_z                 # 起点 z [m]（目前不用，填 0）
float64 s_roll              # 起点 roll [rad]（目前不用，填 0）
float64 s_pitch             # 起点 pitch [rad]（目前不用，填 0）
float64 s_yaw               # ★ 起点朝向 [rad]，逆时针为正

float64 g_x                 # 终点 x [m]
float64 g_y                 # 终点 y [m]
float64 g_z                 # 终点 z [m]（不用，填 0）
float64 g_roll              # 终点 roll [rad]（不用，填 0）
float64 g_pitch             # 终点 pitch [rad]（不用，填 0）
float64 g_yaw               # ★ 终点朝向 [rad] —— 狗头朝哪
                            #   ⚠️ 请明确"狗头朝哪算 0"的约定（见 action.md §9）

float32 pos_tol             # 要求的位置精度 [m]（比如 0.05 = 5cm）
float32 yaw_tol             # ★ 要求的朝向精度 [rad]（要 5° 就填 0.087）
float32 timeout             # 整个任务的超时 [s]
float32 max_speed           # 限速 [m/s]，0 = 不限（比如端着东西时用）

---

# ============================== result（我们 → 组2） ========================
# 任务结束时发一次
#
# ⚠️ 关于 internal_error：它是在【我们自己的里程计坐标系】里的到位误差，
#    闭环会收敛到 ~0 —— 所以它【不能】当"真实误差"看。
#    真实误差需要末端用场景图的已知物体对准才知道。

bool    success             # 到没到 —— ★ 只看这个就够了
geometry_msgs/PoseStamped final_pose   # 实际到位姿（场景图坐标系）
float32 internal_error      # 我们坐标系里的到位误差 [m]
float32 uncertainty         # 我们对自己位置的【不确定度估计】[m]（★ 是估计，不是测量）
string  reason              # 最终状态，取值见下
float32 elapsed             # 从收到目标到结束 [s]

# reason 的取值（★ 下游处理方式完全不同，所以分开报）：
#   arrived          到了
#   timeout          超时              → 可重试
#   blocked          被人/物挡住        → 等一等可重试
#   stuck            走不动了           → 可重试，或换个目标点
#   turn_shift       ★ 位置走到了，但【末端转身】把位置挪偏了 → 直接重试一次
#   no_path          地图上过不去        → ★ 重试没用，要换目标点或换方案
#   aborted          收到急停            → 停下来查原因
#   source_error     里程计出问题        → 检查系统
#   no_pose / stale  位姿源没数据/断流   → 检查系统
#   planning_failed  规划失败            → 检查地图/目标
#   internal_error   内部异常            → 查日志

---

# ============================== feedback（我们 → 组2，10Hz） ================
# 跑的过程中一直发，给组2 画进度条 / 看可视化用

string  stage               # 现在在哪个阶段：
                            #   planning        规划中
                            #   navigating      沿路径走
                            #   fine_approach   末端精调（位置）
                            #   heading_align   末端朝向对准
float32 remaining_dist      # 离目标还差多远 [m]
float32 remaining_yaw       # 朝向还差多少 [rad]
geometry_msgs/PoseStamped current_pose   # 狗的当前位置+朝向（场景图坐标系）
